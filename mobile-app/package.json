{
  "name": "trading-app-mobile",
  "version": "2.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "proxy": "node mobile-api-server.js",
    "dev": "concurrently --names 'PROXY,EXPO' -c cyan,magenta 'node mobile-api-server.js' 'expo start'",
    "dev:ios": "concurrently --names 'PROXY,EXPO' -c cyan,magenta 'node mobile-api-server.js' 'expo start --ios'",
    "dev:android": "concurrently --names 'PROXY,EXPO' -c cyan,magenta 'node mobile-api-server.js' 'expo start --android'",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.62.0",
    "@types/react-dom": "~19.1.7",
    "@vercel/blob": "^2.3.0",
    "cors": "^2.8.5",
    "expo": "~54.0.0",
    "expo-auth-session": "^7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.16",
    "expo-web-browser": "~15.0.10",
    "express": "^5.1.0",
    "http-proxy-middleware": "^3.0.5",
    "lottie-react-native": "~7.3.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.5.1",
    "url-parse": "^1.5.10",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "latest",
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "optionalDependencies": {
    "concurrently": "^8.2.2"
  },
  "private": true
}
