# Mobile Trading App Environment Configuration

# API Configuration - Main app backend URL
API_BASE_URL=https://your-main-trading-app.vercel.app/api
# For local development:
# API_BASE_URL=http://localhost:3000/api

# App Configuration
APP_ENV=development
DEBUG_MODE=true

# Trading Configuration
DEMO_MODE=false
ENABLE_PUSH_NOTIFICATIONS=true

# Analytics (optional)
EXPO_ANALYTICS_ID=your-expo-analytics-id